{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{% block buy_widget_price %}

    {% block custom_product_name %}
        <div class="product-name-below-buybox mt-3">
            <h1 class="product-detail-name">{{ page.product.translated.name }}</h1>
        </div>
    {% endblock %}
    
    {% block custom_Reviews_section %}
        <div class="custom-product-reviews-section d-flex align-items-center">
            {% if product.ratingAverage > 0 and totalReviews > 0 and config('core.listing.showReview') %}
                {% set remoteClickOptions = {
                    selector: '#review-tab-' ~ product.id,
                    scrollToElement: true,
                    excludedViewports: ['XS']
                } %}
                {% set reviewTabHref = '#review-tab-' ~ product.id ~ '-pane' %}
                {% set reviewTabContent = 'review-tab-' ~ product.id ~ '-pane' %}

                <div class="product-detail-reviews d-flex align-items-center">
                    {% sw_include '@Storefront/storefront/component/review/rating.html.twig' with {
                        points: product.ratingAverage,
                        style: 'text-primary'
                    } %}
                    <a class="product-detail-reviews-link ms-2"
                       data-off-canvas-tabs="true"
                       data-remote-click="true"
                       data-remote-click-options="{{ remoteClickOptions|json_encode }}"
                       href="{{ reviewTabHref }}"
                       aria-controls="{{ reviewTabContent }}">
                        {{ totalReviews }} {{ 'detail.reviewLinkText'|trans({'%count%': totalReviews})|sw_sanitize }}
                    </a>
                </div>
            
                <span class="mx-2">|</span>
            {% endif %}
                
                <div class="product-add-review-link" data-show-review-tab-plugin>
                    <button class="btn btn-link-inline js-show-review-tab">
                        {{ 'detail.reviewTeaserButton'|trans|default('Add Your Review') }}
                    </button>
                </div>
        </div>
    {% endblock %}
    
    {{ parent() }}
{% endblock %}

{% block buy_widget_reviews %}
{% endblock %}

{% block buy_widget_ordernumber_container %}
    {{ parent() }}

    {% set catalog = page.extensions.hkB2bCatalog ?? hkB2bCatalog ?? null %}
    {% if catalog and catalog.isEligible and catalog.categoryId %}
        <div class="hk-b2b-catalog-cta mt-2">
            <a href="{{ seoUrl('frontend.navigation.page', { navigationId: catalog.categoryId }) }}"
               class="hk-catalog-cta-link btn btn-outline-primary">
                {{ 'hk.b2bCatalogCta'|trans|sw_sanitize }}
            </a>
        </div>
    {% endif %}
{% endblock %}
