{% sw_extends '@Storefront/storefront/page/account/register/index.html.twig' %}

{% block page_account_register_advantages %}
    {{ parent() }}

    {# Request Account Access section #}
    <div class="b2b-access-request mt-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">{{ 'b2b.requestAccess.title'|trans|sw_sanitize|default('Request Account Access') }}</h5>

                <button class="btn btn-primary w-100 text-uppercase"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#b2bRequestForm"
                        aria-expanded="false"
                        aria-controls="b2bRequestForm">
                    {{ 'b2b.requestAccess.button'|trans|sw_sanitize|default('Request New Access Form') }}
                </button>

                <div class="collapse mt-3" id="b2bRequestForm">
                    <form action="{{ path('frontend.b2b.access.request') }}"
                          method="post"
                          data-form-handler="true">

                        <div class="mb-2">
                            <label class="form-label" for="b2bCompany">{{ 'b2b.requestAccess.company'|trans|sw_sanitize|default('Company Name') }} <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="b2bCompany" name="company" required>
                        </div>

                        <div class="mb-2">
                            <label class="form-label" for="b2bContact">{{ 'b2b.requestAccess.contact'|trans|sw_sanitize|default('Contact Person') }} <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="b2bContact" name="contact" required>
                        </div>

                        <div class="mb-2">
                            <label class="form-label" for="b2bEmail">{{ 'b2b.requestAccess.email'|trans|sw_sanitize|default('Email') }} <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="b2bEmail" name="email" required>
                        </div>

                        <div class="mb-2">
                            <label class="form-label" for="b2bVat">{{ 'b2b.requestAccess.vat'|trans|sw_sanitize|default('VAT Number') }}</label>
                            <input type="text" class="form-control" id="b2bVat" name="vat">
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="b2bReference">{{ 'b2b.requestAccess.reference'|trans|sw_sanitize|default('Customer Reference Number (optional)') }}</label>
                            <input type="text" class="form-control" id="b2bReference" name="reference">
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            {{ 'b2b.requestAccess.submit'|trans|sw_sanitize|default('Send Request') }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_account_register_container %}
    {% set b2bGroupId = config('HansAndKniebesTheme.config.customerGroupRegistrationId') %}
    {% set isB2bMode = page.extensions.b2bMode is defined %}
    {% set b2bGroup = page.extensions.b2bGroup.group ?? null %}

    {% if b2bGroupId and isB2bMode %}
        {# B2B mode: show the customer group registration form #}
        <div class="col-lg-8">
            <div class="card register-card">
                <div class="card-body">

                    {% if b2bGroup.translated.registrationTitle %}
                        <div class="card-title">{{ b2bGroup.translated.registrationTitle }}</div>
                    {% endif %}
                    {% if b2bGroup.translated.registrationIntroduction %}
                        <div class="card-body mb-3">{{ b2bGroup.translated.registrationIntroduction|sw_sanitize }}</div>
                    {% endif %}

                    <form action="{{ path('frontend.account.register.save') }}"
                          class="register-form"
                          method="post"
                          data-form-handler="true">

                        {% set hasSelectedBusiness = b2bGroup.translated.registrationOnlyCompanyRegistration %}

                        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
                        <input type="hidden" name="redirectParameters" value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}">
                        <input type="hidden" name="requestedGroupId" value="{{ b2bGroupId }}">
                        <input type="hidden" name="createCustomerAccount" value="1">
                        <input type="hidden" name="errorRoute" value="frontend.account.login.page">
                        <input type="hidden" name="errorParameters" value="{{ {}|json_encode }}">

                        <fieldset class="register-personal mb-3">
                            <legend class="register-personal-title visually-hidden">
                                {{ 'account.registerPersonalLegend'|trans|sw_sanitize }}
                            </legend>

                            {% sw_include '@Storefront/storefront/component/account/customer-group-register-address-form.twig' with {
                                prefix: 'billingAddress',
                                showBirthdayField: config('core.loginRegistration.showBirthdayField'),
                                data: data.get('billingAddress')
                            } %}

                            {% sw_include '@Storefront/storefront/component/address/address-personal-company.html.twig' with {
                                prefix: 'billingAddress',
                                address: data.get('billingAddress')
                            } %}

                            {# Force accountType=business — must come after AcrisTaxCS injects its own empty field #}
                            <input type="hidden" name="accountType" value="business">

                            <div class="row g-2">
                                {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                    type: 'email',
                                    label: 'account.personalMailLabel'|trans|sw_sanitize,
                                    id: 'personalMail',
                                    name: 'email',
                                    value: data.get('email'),
                                    autocomplete: 'section-personal email',
                                    violationPath: '/email',
                                    validationRules: 'required,email',
                                    additionalClass: 'col-sm-6'
                                } %}

                                {% set passwordFieldDescription = '' %}
                                {% if config('core.loginRegistration.passwordMinLength') != 0 %}
                                    {% set passwordFieldDescription = 'account.personalPasswordDescription'|trans({
                                        '%minLength%': config('core.loginRegistration.passwordMinLength')
                                    })|sw_sanitize %}
                                {% endif %}

                                {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                    type: 'password',
                                    label: 'account.personalPasswordLabel'|trans|sw_sanitize,
                                    id: 'personalPassword',
                                    name: 'password',
                                    autocomplete: 'new-password',
                                    description: passwordFieldDescription,
                                    violationPath: '/password',
                                    validationRules: 'required,minLength',
                                    minlength: config('core.loginRegistration.passwordMinLength'),
                                    additionalClass: 'col-sm-6 js-form-field-toggle-guest-mode'
                                } %}

                                {% if config('core.loginRegistration.requirePasswordConfirmation') %}
                                    {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                        type: 'password',
                                        label: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize,
                                        id: 'personalPasswordConfirmation',
                                        name: 'passwordConfirmation',
                                        autocomplete: 'new-password',
                                        violationPath: '/passwordConfirmation',
                                        validationRules: 'required,confirmation',
                                        additionalClass: 'col-sm-6 js-form-field-toggle-guest-mode'
                                    } %}
                                {% endif %}
                            </div>
                        </fieldset>

                        <div class="register-address mb-5">
                            <fieldset class="register-billing">
                                <legend class="card-title">
                                    {{ 'account.registerAddressBillingHeader'|trans|sw_sanitize }}
                                </legend>
                                {% sw_include '@Storefront/storefront/component/address/address-form.html.twig' with {
                                    prefix: 'billingAddress',
                                    data: data.get('billingAddress'),
                                    showNoShippingPostfix: true,
                                    scopeElementSelector: '.register-billing'
                                } %}
                            </fieldset>

                            <div>
                                <div class="form-check register-different-shipping mb-3">
                                    <input type="checkbox"
                                           class="form-check-input js-different-shipping-checkbox"
                                           name="differentShippingAddress"
                                           value="1"
                                           id="differentShippingAddress"
                                           {% if data.get('differentShippingAddress') %}checked="checked"{% endif %}
                                           data-form-field-toggle="true"
                                           data-form-field-toggle-target=".js-form-field-toggle-shipping-address"
                                           data-form-field-toggle-value="true"
                                           data-form-field-toggle-trigger-nested="true">
                                    <label class="custom-control-label no-validation" for="differentShippingAddress">
                                        {{ 'account.registerDifferentShipping'|trans|sw_sanitize }}
                                    </label>
                                </div>
                                <fieldset class="register-shipping js-form-field-toggle-shipping-address d-none mb-4">
                                    <legend class="card-title">
                                        {{ 'account.registerAddressShippingHeader'|trans|sw_sanitize }}
                                    </legend>
                                    {% sw_include '@Storefront/storefront/component/address/address-personal.html.twig' with {
                                        prefix: 'shippingAddress',
                                        data: data.get('shippingAddress'),
                                        customToggleTarget: true,
                                        accountType: data.get('shippingAddress') ? data.get('shippingAddress').get('accountType') : null
                                    } %}
                                    {% sw_include '@Storefront/storefront/component/address/address-personal-company.html.twig' with {
                                        prefix: 'shippingAddress',
                                        customToggleTarget: true,
                                        address: data.get('shippingAddress')
                                    } %}
                                    {% sw_include '@Storefront/storefront/component/address/address-form.html.twig' with {
                                        prefix: 'shippingAddress',
                                        data: data.get('shippingAddress'),
                                        showNoShippingPostfix: true,
                                        disableNonShippableCountries: true,
                                        scopeElementSelector: '.register-shipping'
                                    } %}
                                </fieldset>
                            </div>
                        </div>

                        {% sw_include '@Storefront/storefront/component/captcha/base.html.twig' %}
                        {% sw_include '@Storefront/storefront/component/privacy-notice.html.twig' %}

                        <p class="register-required-info">
                            {{ 'general.requiredFields'|trans|sw_sanitize }}
                        </p>

                        <div class="register-submit d-grid col-md-6 offset-md-6">
                            <button type="submit" class="btn btn-primary btn-lg">
                                {{ 'account.registerSubmit'|trans|sw_sanitize }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% else %}
        {# Default mode: show standard register form #}
        {{ parent() }}
    {% endif %}
{% endblock %}
