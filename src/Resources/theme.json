{
  "name": "HansAndKniebesTheme",
  "author": "iCreative Technologies",
  "views": [
     "@Storefront",
     "@Plugins",
     "@HansAndKniebesTheme"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/hans-and-kniebes-theme/hans-and-kniebes-theme.js"
